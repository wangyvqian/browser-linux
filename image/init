#!/bin/sh
# The terminal guest ships as an initrd, and the kernel only ever execs /init
# from an initramfs. Mount the kernel filesystems, then hand over to sysvinit.
# The desktop guest boots from a real disk and uses /sbin/init directly.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mount -t tmpfs tmpfs /run

exec /sbin/init "$@"
