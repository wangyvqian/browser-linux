# Started by the autologin getty on tty1. One disk serves both guests, so the
# desktop has to opt in via the kernel cmdline — otherwise the terminal profile
# would pay for X it never asked for.
if [ "$(id -u)" = "0" ] && [ "$(tty)" = "/dev/tty1" ] && [ -z "$DISPLAY" ] \
   && grep -q browserlinux.desktop /proc/cmdline; then
    echo "Starting the desktop. Type 'startx' again if it exits."
    exec startx
fi
